{
  "name": "ilmiyah",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "ILMIYAH: read the Quran with Arabic text, Bangla translation and audio, search it in any language, and read Bangla Islamic articles.",
  "author": "Shahadat Anik",
  "license": "MIT",
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "build": "bun run generate:og && bun --bun vite build",
    "preview": "bun --bun vite preview --port 3000",
    "generate-routes": "bun --bun tsr generate",
    "generate:icons": "bun scripts/generate-icons.tsx",
    "generate:og": "bun scripts/generate-og-images.tsx",
    "fetch:quran": "bun scripts/fetch-quran.ts",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "validate": "bun run check && bun run typecheck && bun run test && bun run build",
    "serve:dist": "bun scripts/serve-dist.ts",
    "verify": "bun scripts/verify-site.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource/amiri-quran": "5.3.0",
    "@fontsource/galada": "5.3.0",
    "@fontsource/hind-siliguri": "5.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.2",
    "lucide-react": "1.77.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@fontsource/geist": "5.3.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/devtools-vite": "0.8.7",
    "@tanstack/react-devtools": "0.10.15",
    "@tanstack/react-router-devtools": "1.167.4",
    "@tanstack/router-cli": "1.168.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/bun": "1.4.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "harfbuzzjs": "1.6.4",
    "playwright-core": "1.65.1",
    "satori": "0.63.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wawoff2": "2.0.1"
  }
}
