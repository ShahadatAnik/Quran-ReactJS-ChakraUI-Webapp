{"number":101,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"الْقَارِعَةُ","bn":"করাঘাতকারী,","juz":30},{"ar":"مَا الْقَارِعَةُ","bn":"করাঘাতকারী কি?","juz":30},{"ar":"وَمَا أَدْرَاكَ مَا الْقَارِعَةُ","bn":"করাঘাতকারী সম্পর্কে আপনি কি জানেন ?","juz":30},{"ar":"يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ","bn":"যেদিন মানুষ হবে বিক্ষিপ্ত পতংগের মত","juz":30},{"ar":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ","bn":"এবং পর্বতমালা হবে ধুনিত রঙ্গীন পশমের মত।","juz":30},{"ar":"فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ","bn":"অতএব যার পাল্লা ভারী হবে,","juz":30},{"ar":"فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ","bn":"সে সুখীজীবন যাপন করবে।","juz":30},{"ar":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ","bn":"আর যার পাল্লা হালকা হবে,","juz":30},{"ar":"فَأُمُّهُ هَاوِيَةٌ","bn":"তার ঠিকানা হবে হাবিয়া।","juz":30},{"ar":"وَمَا أَدْرَاكَ مَا هِيَهْ","bn":"আপনি জানেন তা কি?","juz":30},{"ar":"نَارٌ حَامِيَةٌ","bn":"প্রজ্জ্বলিত অগ্নি!","juz":30}]}
