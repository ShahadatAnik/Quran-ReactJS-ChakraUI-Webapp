{"number":86,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"وَالسَّمَاءِ وَالطَّارِقِ","bn":"শপথ আকাশের এবং রাত্রিতে আগমনকারীর।","juz":30},{"ar":"وَمَا أَدْرَاكَ مَا الطَّارِقُ","bn":"আপনি জানেন, যে রাত্রিতে আসে সেটা কি?","juz":30},{"ar":"النَّجْمُ الثَّاقِبُ","bn":"সেটা এক উজ্জ্বল নক্ষত্র।","juz":30},{"ar":"إِنْ كُلُّ نَفْسٍ لَمَّا عَلَيْهَا حَافِظٌ","bn":"প্রত্যেকের উপর একজন তত্ত্বাবধায়ক রয়েছে।","juz":30},{"ar":"فَلْيَنْظُرِ الْإِنْسَانُ مِمَّ خُلِقَ","bn":"অতএব, মানুষের দেখা উচিত কি বস্তু থেকে সে সৃজিত হয়েছে।","juz":30},{"ar":"خُلِقَ مِنْ مَاءٍ دَافِقٍ","bn":"সে সৃজিত হয়েছে সবেগে স্খলিত পানি থেকে।","juz":30},{"ar":"يَخْرُجُ مِنْ بَيْنِ الصُّلْبِ وَالتَّرَائِبِ","bn":"এটা নির্গত হয় মেরুদন্ড ও বক্ষপাজরের মধ্য থেকে।","juz":30},{"ar":"إِنَّهُ عَلَىٰ رَجْعِهِ لَقَادِرٌ","bn":"নিশ্চয় তিনি তাকে ফিরিয়ে নিতে সক্ষম।","juz":30},{"ar":"يَوْمَ تُبْلَى السَّرَائِرُ","bn":"যেদিন গোপন বিষয়াদি পরীক্ষিত হবে,","juz":30},{"ar":"فَمَا لَهُ مِنْ قُوَّةٍ وَلَا نَاصِرٍ","bn":"সেদিন তার কোন শক্তি থাকবে না এবং সাহায্যকারীও থাকবে না।","juz":30},{"ar":"وَالسَّمَاءِ ذَاتِ الرَّجْعِ","bn":"শপথ চক্রশীল আকাশের","juz":30},{"ar":"وَالْأَرْضِ ذَاتِ الصَّدْعِ","bn":"এবং বিদারনশীল পৃথিবীর","juz":30},{"ar":"إِنَّهُ لَقَوْلٌ فَصْلٌ","bn":"নিশ্চয় কোরআন সত্য-মিথ্যার ফয়সালা।","juz":30},{"ar":"وَمَا هُوَ بِالْهَزْلِ","bn":"এবং এটা উপহাস নয়।","juz":30},{"ar":"إِنَّهُمْ يَكِيدُونَ كَيْدًا","bn":"তারা ভীষণ চক্রান্ত করে,","juz":30},{"ar":"وَأَكِيدُ كَيْدًا","bn":"আর আমিও কৌশল করি।","juz":30},{"ar":"فَمَهِّلِ الْكَافِرِينَ أَمْهِلْهُمْ رُوَيْدًا","bn":"অতএব, কাফেরদেরকে অবকাশ দিন, তাদেরকে অবকাশ দিন, কিছু দিনের জন্যে।","juz":30}]}
