{"number":80,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"عَبَسَ وَتَوَلَّىٰ","bn":"তিনি ভ্রূকুঞ্চিত করলেন এবং মুখ ফিরিয়ে নিলেন।","juz":30},{"ar":"أَنْ جَاءَهُ الْأَعْمَىٰ","bn":"কারণ, তাঁর কাছে এক অন্ধ আগমন করল।","juz":30},{"ar":"وَمَا يُدْرِيكَ لَعَلَّهُ يَزَّكَّىٰ","bn":"আপনি কি জানেন, সে হয়তো পরিশুদ্ধ হত,","juz":30},{"ar":"أَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرَىٰ","bn":"অথবা উপদেশ গ্রহণ করতো এবং উপদেশ তার উপকার হত।","juz":30},{"ar":"أَمَّا مَنِ اسْتَغْنَىٰ","bn":"পরন্তু যে বেপরোয়া,","juz":30},{"ar":"فَأَنْتَ لَهُ تَصَدَّىٰ","bn":"আপনি তার চিন্তায় মশগুল।","juz":30},{"ar":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ","bn":"সে শুদ্ধ না হলে আপনার কোন দোষ নেই।","juz":30},{"ar":"وَأَمَّا مَنْ جَاءَكَ يَسْعَىٰ","bn":"যে আপনার কাছে দৌড়ে আসলো","juz":30},{"ar":"وَهُوَ يَخْشَىٰ","bn":"এমতাবস্থায় যে, সে ভয় করে,","juz":30},{"ar":"فَأَنْتَ عَنْهُ تَلَهَّىٰ","bn":"আপনি তাকে অবজ্ঞা করলেন।","juz":30},{"ar":"كَلَّا إِنَّهَا تَذْكِرَةٌ","bn":"কখনও এরূপ করবেন না, এটা উপদেশবানী।","juz":30},{"ar":"فَمَنْ شَاءَ ذَكَرَهُ","bn":"অতএব, যে ইচ্ছা করবে, সে একে গ্রহণ করবে।","juz":30},{"ar":"فِي صُحُفٍ مُكَرَّمَةٍ","bn":"এটা লিখিত আছে সম্মানিত,","juz":30},{"ar":"مَرْفُوعَةٍ مُطَهَّرَةٍ","bn":"উচ্চ পবিত্র পত্রসমূহে,","juz":30},{"ar":"بِأَيْدِي سَفَرَةٍ","bn":"লিপিকারের হস্তে,","juz":30},{"ar":"كِرَامٍ بَرَرَةٍ","bn":"যারা মহৎ, পূত চরিত্র।","juz":30},{"ar":"قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ","bn":"মানুষ ধ্বংস হোক, সে কত অকৃতজ্ঞ!","juz":30},{"ar":"مِنْ أَيِّ شَيْءٍ خَلَقَهُ","bn":"তিনি তাকে কি বস্তু থেকে সৃষ্টি করেছেন?","juz":30},{"ar":"مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ","bn":"শুক্র থেকে তাকে সৃষ্টি করেছেন, অতঃপর তাকে সুপরিমিত করেছেন।","juz":30},{"ar":"ثُمَّ السَّبِيلَ يَسَّرَهُ","bn":"অতঃপর তার পথ সহজ করেছেন,","juz":30},{"ar":"ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ","bn":"অতঃপর তার মৃত্যু ঘটান ও কবরস্থ করেন তাকে।","juz":30},{"ar":"ثُمَّ إِذَا شَاءَ أَنْشَرَهُ","bn":"এরপর যখন ইচ্ছা করবেন তখন তাকে পুনরুজ্জীবিত করবেন।","juz":30},{"ar":"كَلَّا لَمَّا يَقْضِ مَا أَمَرَهُ","bn":"সে কখনও কৃতজ্ঞ হয়নি, তিনি তাকে যা আদেশ করেছেন, সে তা পূর্ণ করেনি।","juz":30},{"ar":"فَلْيَنْظُرِ الْإِنْسَانُ إِلَىٰ طَعَامِهِ","bn":"মানুষ তার খাদ্যের প্রতি লক্ষ্য করুক,","juz":30},{"ar":"أَنَّا صَبَبْنَا الْمَاءَ صَبًّا","bn":"আমি আশ্চর্য উপায়ে পানি বর্ষণ করেছি,","juz":30},{"ar":"ثُمَّ شَقَقْنَا الْأَرْضَ شَقًّا","bn":"এরপর আমি ভূমিকে বিদীর্ণ করেছি,","juz":30},{"ar":"فَأَنْبَتْنَا فِيهَا حَبًّا","bn":"অতঃপর তাতে উৎপন্ন করেছি শস্য,","juz":30},{"ar":"وَعِنَبًا وَقَضْبًا","bn":"আঙ্গুর, শাক-সব্জি,","juz":30},{"ar":"وَزَيْتُونًا وَنَخْلًا","bn":"যয়তুন, খর্জূর,","juz":30},{"ar":"وَحَدَائِقَ غُلْبًا","bn":"ঘন উদ্যান,","juz":30},{"ar":"وَفَاكِهَةً وَأَبًّا","bn":"ফল এবং ঘাস","juz":30},{"ar":"مَتَاعًا لَكُمْ وَلِأَنْعَامِكُمْ","bn":"তোমাদেরও তোমাদের চতুস্পদ জন্তুদের উপাকারার্থে।","juz":30},{"ar":"فَإِذَا جَاءَتِ الصَّاخَّةُ","bn":"অতঃপর যেদিন কর্ণবিদারক নাদ আসবে,","juz":30},{"ar":"يَوْمَ يَفِرُّ الْمَرْءُ مِنْ أَخِيهِ","bn":"সেদিন পলায়ন করবে মানুষ তার ভ্রাতার কাছ থেকে,","juz":30},{"ar":"وَأُمِّهِ وَأَبِيهِ","bn":"তার মাতা, তার পিতা,","juz":30},{"ar":"وَصَاحِبَتِهِ وَبَنِيهِ","bn":"তার পত্নী ও তার সন্তানদের কাছ থেকে।","juz":30},{"ar":"لِكُلِّ امْرِئٍ مِنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْنِيهِ","bn":"সেদিন প্রত্যেকেরই নিজের এক চিন্তা থাকবে, যা তাকে ব্যতিব্যস্ত করে রাখবে।","juz":30},{"ar":"وُجُوهٌ يَوْمَئِذٍ مُسْفِرَةٌ","bn":"অনেক মুখমন্ডল সেদিন হবে উজ্জ্বল,","juz":30},{"ar":"ضَاحِكَةٌ مُسْتَبْشِرَةٌ","bn":"সহাস্য ও প্রফুল্ল।","juz":30},{"ar":"وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌ","bn":"এবং অনেক মুখমন্ডল সেদিন হবে ধুলি ধূসরিত।","juz":30},{"ar":"تَرْهَقُهَا قَتَرَةٌ","bn":"তাদেরকে কালিমা আচ্ছন্ন করে রাখবে।","juz":30},{"ar":"أُولَٰئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ","bn":"তারাই কাফের পাপিষ্ঠের দল।","juz":30}]}
