{"number":104,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ","bn":"প্রত্যেক পশ্চাতে ও সম্মুখে পরনিন্দাকারীর দুর্ভোগ,","juz":30},{"ar":"الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ","bn":"যে অর্থ সঞ্চিত করে ও গণনা করে","juz":30},{"ar":"يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ","bn":"সে মনে করে যে, তার অর্থ চিরকাল তার সাথে থাকবে!","juz":30},{"ar":"كَلَّا ۖ لَيُنْبَذَنَّ فِي الْحُطَمَةِ","bn":"কখনও না, সে অবশ্যই নিক্ষিপ্ত হবে পিষ্টকারীর মধ্যে।","juz":30},{"ar":"وَمَا أَدْرَاكَ مَا الْحُطَمَةُ","bn":"আপনি কি জানেন, পিষ্টকারী কি?","juz":30},{"ar":"نَارُ اللَّهِ الْمُوقَدَةُ","bn":"এটা আল্লাহর প্রজ্জ্বলিত অগ্নি,","juz":30},{"ar":"الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ","bn":"যা হৃদয় পর্যন্ত পৌছবে।","juz":30},{"ar":"إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ","bn":"এতে তাদেরকে বেঁধে দেয়া হবে,","juz":30},{"ar":"فِي عَمَدٍ مُمَدَّدَةٍ","bn":"লম্বা লম্বা খুঁটিতে।","juz":30}]}
