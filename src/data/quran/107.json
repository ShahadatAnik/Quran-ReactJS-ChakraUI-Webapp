{"number":107,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"أَرَأَيْتَ الَّذِي يُكَذِّبُ بِالدِّينِ","bn":"আপনি কি দেখেছেন তাকে, যে বিচারদিবসকে মিথ্যা বলে?","juz":30},{"ar":"فَذَٰلِكَ الَّذِي يَدُعُّ الْيَتِيمَ","bn":"সে সেই ব্যক্তি, যে এতীমকে গলা ধাক্কা দেয়","juz":30},{"ar":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ","bn":"এবং মিসকীনকে অন্ন দিতে উৎসাহিত করে না।","juz":30},{"ar":"فَوَيْلٌ لِلْمُصَلِّينَ","bn":"অতএব দুর্ভোগ সেসব নামাযীর,","juz":30},{"ar":"الَّذِينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَ","bn":"যারা তাদের নামায সম্বন্ধে বে-খবর;","juz":30},{"ar":"الَّذِينَ هُمْ يُرَاءُونَ","bn":"যারা তা লোক-দেখানোর জন্য করে","juz":30},{"ar":"وَيَمْنَعُونَ الْمَاعُونَ","bn":"এবং নিত্য ব্যবহার্য্য বস্তু অন্যকে দেয় না।","juz":30}]}
