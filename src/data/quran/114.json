{"number":114,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"قُلْ أَعُوذُ بِرَبِّ النَّاسِ","bn":"বলুন, আমি আশ্রয় গ্রহণ করিতেছি মানুষের পালনকর্তার,","juz":30},{"ar":"مَلِكِ النَّاسِ","bn":"মানুষের অধিপতির,","juz":30},{"ar":"إِلَٰهِ النَّاسِ","bn":"মানুষের মা’বুদের","juz":30},{"ar":"مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِ","bn":"তার অনিষ্ট থেকে, যে কুমন্ত্রণা দেয় ও আত্নগোপন করে,","juz":30},{"ar":"الَّذِي يُوَسْوِسُ فِي صُدُورِ النَّاسِ","bn":"যে কুমন্ত্রণা দেয় মানুষের অন্তরে","juz":30},{"ar":"مِنَ الْجِنَّةِ وَالنَّاسِ","bn":"জ্বিনের মধ্য থেকে অথবা মানুষের মধ্য থেকে।","juz":30}]}
