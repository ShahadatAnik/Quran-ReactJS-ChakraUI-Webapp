{"number":102,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"أَلْهَاكُمُ التَّكَاثُرُ","bn":"প্রাচুর্যের লালসা তোমাদেরকে গাফেল রাখে,","juz":30},{"ar":"حَتَّىٰ زُرْتُمُ الْمَقَابِرَ","bn":"এমনকি, তোমরা কবরস্থানে পৌছে যাও।","juz":30},{"ar":"كَلَّا سَوْفَ تَعْلَمُونَ","bn":"এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।","juz":30},{"ar":"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَ","bn":"অতঃপর এটা কখনও উচিত নয়। তোমরা সত্ত্বরই জেনে নেবে।","juz":30},{"ar":"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَقِينِ","bn":"কখনই নয়; যদি তোমরা নিশ্চিত জানতে।","juz":30},{"ar":"لَتَرَوُنَّ الْجَحِيمَ","bn":"তোমরা অবশ্যই জাহান্নাম দেখবে,","juz":30},{"ar":"ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِينِ","bn":"অতঃপর তোমরা তা অবশ্যই দেখবে দিব্য প্রত্যয়ে,","juz":30},{"ar":"ثُمَّ لَتُسْأَلُنَّ يَوْمَئِذٍ عَنِ النَّعِيمِ","bn":"এরপর অবশ্যই সেদিন তোমরা নেয়ামত সম্পর্কে জিজ্ঞাসিত হবে।","juz":30}]}
