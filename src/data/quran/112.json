{"number":112,"bismillah":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ","ayahs":[{"ar":"قُلْ هُوَ اللَّهُ أَحَدٌ","bn":"বলুন, তিনি আল্লাহ, এক,","juz":30},{"ar":"اللَّهُ الصَّمَدُ","bn":"আল্লাহ অমুখাপেক্ষী,","juz":30},{"ar":"لَمْ يَلِدْ وَلَمْ يُولَدْ","bn":"তিনি কাউকে জন্ম দেননি এবং কেউ তাকে জন্ম দেয়নি","juz":30},{"ar":"وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ","bn":"এবং তার সমতুল্য কেউ নেই।","juz":30}]}
